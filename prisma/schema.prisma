generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  Applied
  OA_Scheduled
  OA_Completed
  Recruiter_Screening
  Technical_Round_1
  Technical_Round_2
  Technical_Round_3
  Managerial_Round
  HR_Round
  Offer_Received
  Accepted
  Rejected
  Withdrawn
}

enum ApplicationSource {
  LinkedIn
  Naukri
  Indeed
  Company_Website
  Referral
  Glassdoor
  Other
}

enum ApplicationType {
  Remote
  Hybrid
  Onsite
}

enum Currency {
  INR
  USD
  EUR
  GBP
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  position    String
  country     String            @default("India")
  location    String?
  jobLink     String?
  jobDescLink String?
  source      ApplicationSource @default(Other)
  status      ApplicationStatus @default(Applied)

  applicationType ApplicationType @default(Onsite)
  visaSponsorship Boolean         @default(false)
  relocation      Boolean         @default(false)
  referral        Boolean         @default(false)
  targetSalary    String?
  currency        Currency        @default(INR)

  appliedDate       DateTime  @default(now())
  nextInterviewDate DateTime?
  offerDate         DateTime?
  joiningDate       DateTime?

  recruiterName     String?
  recruiterEmail    String?
  recruiterLinkedIn String?

  notes             String? @db.Text
  interviewFeedback String? @db.Text

  resumeFileName   String?
  resumeFilePath   String?
  resumeUploadDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory StatusHistory[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, appliedDate])
}

model StatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedAt     DateTime           @default(now())

  @@index([applicationId])
}
