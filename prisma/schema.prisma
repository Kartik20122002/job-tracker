generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  Applied
  OA_Scheduled
  OA_Completed
  Recruiter_Screening
  Technical_Round_1
  Technical_Round_2
  Technical_Round_3
  Managerial_Round
  HR_Round
  Offer_Received
  Accepted
  Rejected
  Withdrawn
}

enum ApplicationSource {
  LinkedIn
  Naukri
  Indeed
  Company_Website
  Referral
  Glassdoor
  Other
}

enum ApplicationType {
  Remote
  Hybrid
  Onsite
}

enum Currency {
  INR
  USD
  EUR
  GBP
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum MatchedBy {
  RECRUITER_EMAIL
  RECRUITER_DOMAIN
  COMPANY_SUBJECT
  COMPANY_SNIPPET
  POSITION_TITLE
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  applications    Application[]
  gmailConnection GmailConnection?
  gmailSyncs      GmailSync[]
}

model GmailConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAddress String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GmailSync {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  emailsScanned Int        @default(0)
  emailsMatched Int        @default(0)
  status        SyncStatus @default(RUNNING)

  @@index([userId])
  @@index([userId, startedAt])
}

model EmailActivity {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  gmailMessageId String      @unique
  gmailThreadId  String
  sender         String
  senderEmail    String
  subject        String
  snippet        String      @db.Text
  receivedAt     DateTime
  matchedBy      MatchedBy
  createdAt      DateTime    @default(now())

  @@index([applicationId])
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  position    String
  country     String            @default("India")
  location    String?
  jobLink     String?
  jobDescLink String?
  source      ApplicationSource @default(Other)
  status      ApplicationStatus @default(Applied)

  applicationType ApplicationType @default(Onsite)
  visaSponsorship Boolean         @default(false)
  relocation      Boolean         @default(false)
  referral        Boolean         @default(false)
  targetSalary    String?
  currency        Currency        @default(INR)

  appliedDate       DateTime  @default(now())
  nextInterviewDate DateTime?
  offerDate         DateTime?
  joiningDate       DateTime?

  recruiterName     String?
  recruiterEmail    String?
  recruiterLinkedIn String?

  notes             String? @db.Text
  interviewFeedback String? @db.Text

  resumeFileName   String?
  resumeFilePath   String?
  resumeUploadDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory   StatusHistory[]
  emailActivities EmailActivity[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, appliedDate])
}

model StatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedAt     DateTime           @default(now())

  @@index([applicationId])
}
