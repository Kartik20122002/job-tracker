# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
# Set to your actual domain in production (must match Google Cloud Console authorized redirect URI)
# Dev:  http://localhost:3000
# Prod: [deployed url]
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — same client ID/secret used for both NextAuth sign-in and Gmail integration.
# In Google Cloud Console → Credentials → your OAuth client, add ALL of these as Authorized Redirect URIs:
#   Dev  sign-in:  http://localhost:3000/api/auth/callback/google
#   Dev  Gmail:    http://localhost:3000/api/gmail/callback
#   Prod sign-in: [deployed url]/api/auth/callback/google
#   Prod Gmail:   [deployed url]/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Supabase (for Storage — resume file uploads)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

