# Database
DATABASE_URL=postgresql://jobuser:jobpassword@localhost:5432/jobtracker
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=jobpassword
POSTGRES_DB=jobtracker

# Auth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Gmail Integration (Google OAuth) - see instructions.md for setup steps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
