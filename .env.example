# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Gmail Integration (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Supabase (for Storage — resume file uploads)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resume upload access control (comma-separated email addresses)
RESUME_UPLOAD_ALLOWED_EMAILS=
