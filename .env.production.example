# ─── Database ────────────────────────────────────────────────────────────────
# In production the app runs inside Docker, so hostname is the service name "postgres"
DATABASE_URL=postgresql://jobuser:CHANGE_THIS_PASSWORD@postgres:5432/jobtracker
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=jobtracker

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_generate_with_openssl_rand_base64_32
# Your actual production domain (no trailing slash)
NEXTAUTH_URL=https://yourdomain.com

# ─── File uploads ────────────────────────────────────────────────────────────
# /app/uploads is correct for Docker — do NOT change this for production
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# ─── Gmail Integration ───────────────────────────────────────────────────────
# Add your production domain to "Authorized redirect URIs" in Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# Must exactly match what you registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/gmail/callback
